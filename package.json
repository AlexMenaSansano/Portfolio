{
  "name": "alexandra-mena-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "bash scripts/build-preview.sh",
    "publish:preview": "bash scripts/publish-preview.sh",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@fontsource/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0"
  },
  "devDependencies": { "@playwright/test": "^1.58.2" }
}
