---
import { sitePath } from "../lib/paths";
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Contact from '../components/Contact.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, collections } from '../data/portfolio';
const selected = ['bbva-business-banking', 'coca-cola-ai-workspace', 'caixabank-manager-tool', 'zip-water-interface'].map(slug => projects.find(project => project.slug === slug)!);
---
<Layout>
  <section class="hero-v2 container">
    <div class="hero-v2-top"><span>Independent perspective.<br />Lead Product Designer.</span><span>Based in Madrid.<br />Working across contexts.</span></div>
    <div class="hero-v2-main">
      <div class="hero-v2-type"><h1><span>Good ideas</span><span class="hero-second-line"><span>need a way</span> <span class="hero-last-line">forward.<svg class="hero-star" aria-hidden="true" viewBox="0 0 100 100"><path d="M50 0v100M0 50h100M15 15l70 70M15 85l70-70"/></svg></span></span></h1></div>
    </div>
    <div class="hero-v2-bottom"><p>I connect product strategy, human behaviour and technology. Then I lead the decisions that turn a brief into something people can use.</p><a class="hero-work-link" href={sitePath("/work/")}><span>Explore the work</span><span class="hero-link-arrow"><Arrow diagonal /></span></a></div>
  </section>
  <div class="practice-ticker"><span class="sr-only">Product strategy, behavioural design, applied AI, physical and digital experiences.</span><div class="ticker-track" aria-hidden="true">{[0,1].map(() => <div class="ticker-group">{['Product strategy','Human behaviour','Applied AI','Physical + digital'].map(label => <><span>{label}</span><span class="ticker-dot"><svg viewBox="0 0 100 100"><path d="M50 0v100M0 50h100M15 15l70 70M15 85l70-70"/></svg></span></>)}</div>)}</div><button class="ticker-pause" aria-label="Pause animation" aria-pressed="false"><svg class="pause-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10"/></svg><svg class="play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 8 5-8 5z"/></svg></button></div>

  <section class="perspective-section" id="perspective">
    <div class="container perspective-grid"><div class="section-kicker"><span class="small-square"></span>The perspective</div><div><h2>I work where the brief<br />is still taking shape,<br />and <em>the decisions matter.</em></h2><div class="perspective-text"><p>My background brings together audiovisual communication, photography, behavioural economics and product design. It shapes how I read a situation, find its story and give it a usable form.</p><p>That can mean aligning a banking platform across six markets, shaping an AI workspace or designing the screen inside a kitchen tap. I stay close to the work, from the first questions to prototyping, systems and delivery.</p></div><a class="text-link" href={sitePath("/profile/")}>Meet Álex <Arrow diagonal /></a></div></div>
  </section>

  <section class="proof-section container" aria-label="Experience at a glance">
    <div class="proof-item"><span class="proof-number">6<span>markets</span></span><p>One global BBVA platform</p></div>
    <div class="proof-item"><span class="proof-number">72<span>+</span></span><p>Stakeholders aligned in BBVA</p></div>
    <div class="proof-item"><span class="proof-number">22<span>people</span></span><p>Largest team coordinated</p></div>
    <div class="proof-item"><span class="proof-number">10<span>+</span></span><p>Years across design & delivery</p></div>
  </section>

  <section class="work-section container" id="selected-work">
    <div class="section-heading"><div><div class="section-kicker"><span class="small-square"></span>Selected work</div><h2>Different contexts.<br /><em>A consistent responsibility.</em></h2></div><a class="text-link" href={sitePath("/work/")}>All projects <Arrow diagonal /></a></div>
    <div class="project-grid">{selected.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <div class="work-footnote"><span>About the visuals</span><p>The covers use original conceptual artwork to introduce each story. They are not client deliverables. The cases share my responsibility, decisions and documented outcomes; client interfaces remain private.</p></div>
  </section>

  <section class="approach-section" id="approach"><div class="container"><div class="section-heading"><div><div class="section-kicker"><span class="small-square"></span>How I contribute</div><h2>A point of view,<br />carried <em>through the work.</em></h2></div><p class="section-aside">Direction is useful when it helps people make the next decision.</p></div><div class="approach-list">
    <div class="approach-row"><span class="approach-index">01</span><h3>Make the problem clear.</h3><p>Connect people’s needs, the business context and the technical constraints. Decide what the product should help someone do.</p></div>
    <div class="approach-row"><span class="approach-index">02</span><h3>Give the idea a form.</h3><p>Bring narrative, structure and interaction together. Use prototypes to make a direction tangible enough to discuss and test.</p></div>
    <div class="approach-row"><span class="approach-index">03</span><h3>Bring people with it.</h3><p>Make decisions visible across disciplines. Align teams and stakeholders around a direction they understand and can build.</p></div>
    <div class="approach-row"><span class="approach-index">04</span><h3>Stay through delivery.</h3><p>Follow the work through systems, documentation and implementation. Keep the product’s logic intact as it moves between teams.</p></div>
  </div></div></section>

  <section class="collections-section container"><div class="section-heading"><div><div class="section-kicker"><span class="small-square"></span>Three ways into the work</div><h2>Find the <em>relevant perspective.</em></h2></div><p class="section-aside">A focused selection for the conversation you want to have.</p></div><div class="collection-grid">{collections.map((collection, i) => <a class="collection-card" href={sitePath(`/focus/${collection.slug}/`)}><span class="collection-index">0{i + 1}</span><h3>{collection.label}</h3><p>{collection.intro}</p><span class="text-link">Explore selection <Arrow diagonal /></span></a>)}</div></section>
  <Contact />
  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const pauseButton = document.querySelector<HTMLButtonElement>('.ticker-pause');
    pauseButton?.addEventListener('click', () => {
      const paused = pauseButton.getAttribute('aria-pressed') !== 'true';
      pauseButton.setAttribute('aria-pressed', String(paused));
      pauseButton.setAttribute('aria-label', paused ? 'Resume animation' : 'Pause animation');
      document.body.dataset.motionPaused = String(paused);
    });
    document.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
      card.addEventListener('pointermove', event => {
        if (reducedMotion.matches || !finePointer.matches) return;
        const art = card.querySelector<HTMLElement>('.project-art');
        if (!art) return;
        const rect = art.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width - .5) * 2));
        const y = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height - .5) * 2));
        art.style.setProperty('--art-x', `${x * 8}px`);
        art.style.setProperty('--art-y', `${y * 8}px`);
        art.style.setProperty('--art-rotate', `${x * 1.2}deg`);
      });
      card.addEventListener('pointerleave', () => {
        const art = card.querySelector<HTMLElement>('.project-art');
        art?.style.setProperty('--art-x', '0px');
        art?.style.setProperty('--art-y', '0px');
        art?.style.setProperty('--art-rotate', '0deg');
      });
    });
  </script>
</Layout>
