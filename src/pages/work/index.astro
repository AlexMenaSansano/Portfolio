---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/portfolio';
---
<Layout title="Selected work — Álex Mena" active="work">
  <section class="page-heading container"><div class="section-kicker"><span class="small-square"></span>Selected work / 2022—2026</div><h1>The decisions behind<br /><em>the product.</em></h1><p class="page-intro">Global platforms, AI products, brand transformations and physical–digital experiences. Each case makes my responsibility, the decisions and the outcome visible.</p></section>
  <section class="work-index container" aria-label="Projects">
    <div class="work-filters" role="group" aria-label="Filter projects"><button class="filter-button active" data-filter="all" aria-pressed="true">All work <span>05</span></button><button class="filter-button" data-filter="leadership" aria-pressed="false">Product leadership</button><button class="filter-button" data-filter="ai" aria-pressed="false">Product & AI</button><button class="filter-button" data-filter="principal" aria-pressed="false">Staff / Principal</button></div>
    <p class="filter-count sr-only" aria-live="polite">5 projects shown</p>
    <div class="project-grid" id="project-list">{projects.map((project, index) => <div class="project-filter-item" data-lenses={project.lenses.join(' ')}><ProjectCard project={project} index={index} /></div>)}</div>
    <div class="work-footnote"><span>Reading the cases</span><p>The accounts are based on evidence documented in September 2026. Each case separates delivery from implementation and measured impact. Confidential client interfaces are kept private.</p></div>
  </section>
  <Contact />
  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('[data-lenses]');
    const count = document.querySelector('.filter-count');
    filters.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      let visible = 0;
      items.forEach(item => {
        item.hidden = filter !== 'all' && !item.dataset.lenses?.split(' ').includes(filter ?? '');
        if (!item.hidden) visible++;
      });
      filters.forEach(other => {
        const active = other === button;
        other.classList.toggle('active', active);
        other.setAttribute('aria-pressed', String(active));
      });
      if (count) count.textContent = `${visible} projects shown`;
    }));
  </script>
</Layout>
