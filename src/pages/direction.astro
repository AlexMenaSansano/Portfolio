---
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/direction.css';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { sitePath } from '../lib/paths';
import { person, projects } from '../data/portfolio';
import { collaborations } from '../data/collaborations';

const projectPath = (slug: string) => sitePath(`/work/${slug}/`);
const featured = [
  { slug: 'bbva-business-banking', title: 'One product direction. Six markets to align.', focus: 'International product leadership', summary: 'I led the global platform from definition to implementation, then continued through responsive standardisation and Financial Health in Spain.' },
  { slug: 'movelia-brand-and-booking', title: 'The brand promise. All the way to booking.', focus: 'Multidisciplinary design direction', summary: 'I led narrative, identity and the reservation experience, bringing product, visual design and writing together with the client.' },
  { slug: 'coca-cola-ai-workspace', title: 'Four programmes. One way into the knowledge.', focus: 'AI product direction', summary: 'I led the interaction model and day-to-day design decisions for an internal AI workspace, in close collaboration with technology.' },
].map(item => ({ ...projects.find(project => project.slug === item.slug)!, ...item }));
const archive = collaborations.map(item => ({ ...projects.find(project => project.slug === item.slug)!, ...item }));
const powers = ['Product direction', 'Human behaviour', 'Visual storytelling', 'Team leadership'];
---
<Layout title="Álex Mena — Product direction & design leadership" description="I set product direction and lead teams through delivery. A human perspective on product, design and the people who make it happen." homeHref={sitePath('/direction/')} workHref="#selected-work" profileHref="#about" profileLabel="About" approachHref="#approach" archiveHref="#archives" headerRole="Lead Product Designer" showFooter={false}>
  <div class="direction">
    <section class="gallery-hero home-chapter" id="direction" data-chapter="01 / Direction" aria-labelledby="direction-title">
      <img class="gallery-hero-image" src={sitePath('/images/shared-direction.webp')} width="1672" height="941" alt="" fetchpriority="high" />
      <div class="hero-content editorial-shell">
        <div class="hero-topline"><span class="chapter-label">01 / Product direction</span><span>Business. People. Technology.</span></div>
        <h1 id="direction-title">I set product direction.<br />And lead teams<br /><em>through delivery.</em></h1>
        <div class="hero-bottom"><ul class="superpowers" aria-label="My strengths">{powers.map((power, i) => <li><span aria-hidden="true">0{i + 1}</span>{power}</li>)}</ul><a class="hero-next" href="#about">Meet the person behind the work <Arrow /></a></div>
      </div>
    </section>

    <section class="about-chapter home-chapter editorial-shell" id="about" data-chapter="02 / About" aria-labelledby="about-title">
      <div class="chapter-topline"><span class="chapter-label">02 / A little context</span><span>Álex Mena / Madrid, Spain</span></div>
      <div class="identity-context"><p>I’m Alexandra Mena Sansano.<br />A product designer with a human perspective.</p><p>Based in Madrid.<br />Open to hybrid roles in Madrid<br />and remote roles from Spain.</p></div>
      <h2 class="identity-title" id="about-title"><span>PRODUCT</span><span>DESIGN <em>&</em></span><span>LEADERSHIP<span class="identity-period">.</span></span></h2>
      <div class="identity-bottom"><p>I connect business goals, human behaviour and technology to lead design across banking platforms, AI workspaces and connected products.</p><a class="editorial-link" href={`mailto:${person.email}`}>Let’s talk <Arrow diagonal /></a></div>
      <dl class="scope-grid" aria-label="Experience across projects"><div><dt>6</dt><dd>Geographies<span>Experience leading international projects</span></dd></div><div><dt>72+</dt><dd>Stakeholders<span>Alignment across complex product ecosystems</span></dd></div><div><dt>22</dt><dd>People<span>Largest team coordinated</span></dd></div></dl>
    </section>

    <section class="perspective-chapter home-chapter editorial-shell" id="perspective" data-chapter="03 / Perspective" aria-labelledby="perspective-title">
      <div class="chapter-topline"><span class="chapter-label">03 / The person in the work</span><span>A shared direction starts with a conversation.</span></div>
      <div class="perspective-composition"><div class="perspective-copy"><h2 id="perspective-title">Set the direction.<br />Bring people into it.<br /><em>Help them go further.</em></h2><p>My background combines audiovisual communication, photography, behavioural economics and product design. It shapes how I read a context, pay attention to people and give an idea a form.</p><p>I listen to the people closest to the work—their ideas, doubts and ambitions. I want the team to feel heard and have the confidence to make the work their own.</p><a class="editorial-link" href={sitePath('/profile/')}>A little more about me <Arrow diagonal /></a></div><figure class="perspective-study"><img src={sitePath('/images/shared-perspective.webp')} width="1448" height="1086" alt="Editorial study of two hands arranging paper shapes together on a sunlit table." loading="lazy" /><figcaption>Different perspectives. A shared direction.<span>Editorial study</span></figcaption></figure></div>
    </section>

    <section class="work-chapter home-chapter" id="selected-work" data-chapter="04 / Selected work" aria-labelledby="selected-work-title">
      <div class="work-opening editorial-shell"><div><span class="chapter-label">04 / Projects</span><h2 id="selected-work-title">Selected <em>work.</em></h2><p>Product direction, the teams behind it, and what we delivered.</p></div><div class="gallery-controls"><span class="gallery-count" aria-live="polite" aria-atomic="true"><span data-gallery-current>01</span> / 03</span><button type="button" data-gallery-previous aria-label="Previous project" disabled><span class="previous-arrow"><Arrow /></span></button><button type="button" data-gallery-next aria-label="Next project"><Arrow /></button></div></div>
      <div class="project-gallery" tabindex="0" role="region" aria-label="Selected projects gallery. Use the arrow keys to browse.">
        {featured.map((project, i) => <article class:list={['gallery-project', `gallery-project-${project.art}`]} id={i === 0 ? 'global-platform' : i === 1 ? 'brand-product' : 'applied-ai'} aria-label={`${project.client}, ${i + 1} of 3`}>
          <a class="project-visual-link" href={projectPath(project.slug)} aria-label={`Read the ${project.client} case`}>
            <div class:list={['project-exhibit', `exhibit-${project.art}`]} aria-hidden="true"><div class="exhibit-topline"><span>{project.client}</span><span>{project.status}</span></div>
              {project.art === 'bbva' && <><img class="exhibit-map" src={sitePath('/images/markets-map.svg')} width="720" height="310" alt="" loading="lazy" /><div class="exhibit-statement"><strong>06</strong><span>markets.<br />one shared model.</span></div><div class="exhibit-baseline"><span>Architecture · Interaction · Local requirements</span><Arrow diagonal /></div></>}
              {project.art === 'movelia' && <><div class="exhibit-brand"><span>Narrative</span><Arrow diagonal /><span>Identity</span><Arrow diagonal /><span>Booking</span></div><div class="exhibit-baseline"><span>One connected direction</span><Arrow diagonal /></div></>}
              {project.art === 'coca-cola' && <><div class="exhibit-knowledge"><div class="knowledge-programmes">{[1,2,3,4].map(n => <span>0{n}</span>)}</div><span class="knowledge-line"></span><strong>One entry point.</strong></div><div class="exhibit-baseline"><span>Find precedents · Develop ideas · Connect people</span><Arrow diagonal /></div></>}
            </div>
          </a>
          <div class="project-caption"><div class="project-caption-meta"><span>0{i + 1} / {project.client}</span><span>{project.year}</span></div><div class="project-caption-body"><div><span class="project-focus">{project.focus}</span><h3><a href={projectPath(project.slug)}>{project.title}</a></h3></div><div><p>{project.summary}</p><a class="editorial-link" href={projectPath(project.slug)}>Read the case <Arrow diagonal /></a></div></div></div>
        </article>)}
      </div>
      <div class="work-bottom editorial-shell"><p>The project visuals are editorial diagrams of the documented scope. Client interfaces remain private.</p><a class="editorial-link" href={sitePath('/work/')}>All five cases <Arrow diagonal /></a></div>
    </section>

    <section class="approach-chapter home-chapter" id="approach" data-chapter="05 / How I lead" aria-labelledby="approach-title">
      <div class="approach-image"><img src={sitePath('/images/shared-direction.webp')} width="1672" height="941" alt="" loading="lazy" /><div class="approach-image-copy editorial-shell"><span class="chapter-label">05 / How I lead</span><h2 id="approach-title">Clear direction.<br /><em>Room to grow.</em></h2><p>I want people to feel heard, trusted and confident enough to go beyond what they thought they could do.</p></div></div>
      <div class="practice-grid editorial-shell"><div><span>01 / Listen</span><h3>Make room for every voice.</h3><p>I listen before deciding. I ask what people see, what they need and where they feel uncertain, so their perspective can shape the work.</p></div><div><span>02 / Empower</span><h3>Share the context. Give ownership.</h3><p>I make the direction and expectations clear, then give people room to make decisions and bring their own judgement to the solution.</p></div><div><span>03 / Support</span><h3>Build confidence to stretch.</h3><p>I make it safe to ask questions, challenge a direction and try something new. Honest feedback and steady support help people grow beyond their own expectations.</p></div></div>
      <div class="practice-delivery editorial-shell"><span class="chapter-label">And through the work</span><p>I stay close to prototypes, systems and delivery—helping the team resolve the detail and keeping the product’s logic intact through implementation.</p></div>
    </section>

    <section class="archive-chapter home-chapter editorial-shell" id="archives" data-chapter="06 / Archives" aria-labelledby="archives-title"><div class="chapter-topline"><span class="chapter-label">06 / Collaborations</span><span>Client, responsibility & year</span></div><div class="archive-heading"><h2 id="archives-title">Archives<em>.</em></h2><p>A selection across banking, mobility, AI and connected products.</p></div><div class="archive-labels" aria-hidden="true"><span>Client</span><span>Responsibility</span><span>Year</span><span></span></div><ul class="archive-list" aria-label="Selected client collaborations">{archive.map(project => <li><a class="archive-row" href={projectPath(project.slug)}><span class="archive-client">{project.client}</span><span class="archive-role">{project.responsibility}</span><span class="archive-year">{project.year}</span><span><span class="sr-only">Read the {project.client} case</span><Arrow diagonal /></span></a></li>)}</ul></section>

    <footer class="contact-chapter home-chapter editorial-shell" id="contact" data-chapter="07 / Let’s talk" aria-labelledby="contact-title"><div class="chapter-topline"><span class="chapter-label">07 / A conversation</span><span>Madrid / Spanish & English</span></div><h2 id="contact-title">Let’s build<br />something<br /><em>worth caring about.</em></h2><div class="contact-invitation"><p>A product to shape. A team to grow.<br />I’d love to hear what you have in mind.</p><a class="contact-email" href={`mailto:${person.email}`}>{person.email}<Arrow diagonal /></a></div><div class="contact-footer"><span>© {new Date().getUTCFullYear()} Álex Mena</span><div><a href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow diagonal /></a><a href={sitePath(person.cv)} download>CV <Arrow diagonal /></a><a href="#direction">Back to top ↑</a></div><details class="image-credit"><summary>Image credits</summary><p>Original AI-generated editorial artwork for this portfolio. Project graphics illustrate documented scope and are not client deliverables.</p></details></div></footer>
  </div>
  <script>
    const track = document.querySelector<HTMLElement>('.project-gallery');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.gallery-project'));
    const previous = document.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const next = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const counter = document.querySelector<HTMLElement>('[data-gallery-current]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    const positions = () => cards.map(card => track ? card.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft - parseFloat(getComputedStyle(track).paddingLeft) : 0);
    const updateGallery = () => {
      if (!track) return;
      const offsets = positions();
      current = offsets.reduce((best, position, i) => Math.abs(position - track.scrollLeft) < Math.abs(offsets[best] - track.scrollLeft) ? i : best, 0);
      if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      if (previous) previous.disabled = current === 0;
      if (next) next.disabled = current === cards.length - 1;
    };
    const goTo = (index: number) => {
      if (!track) return;
      const target = Math.max(0, Math.min(cards.length - 1, index));
      track.scrollTo({ left: positions()[target], behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };
    previous?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    track?.addEventListener('scroll', updateGallery, { passive: true });
    track?.addEventListener('keydown', event => {
      if (event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault(); goTo(current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    if (track) new ResizeObserver(updateGallery).observe(track);
    updateGallery();

    const chapters = Array.from(document.querySelectorAll<HTMLElement>('.home-chapter'));
    const chapterLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a[href^="#"], .mobile-nav a[href^="#"]'));
    const updateChapter = () => {
      const threshold = window.innerHeight * .3;
      let active = chapters[0];
      chapters.forEach(chapter => { if (chapter.getBoundingClientRect().top <= threshold) active = chapter; });
      if (document.body.dataset.directionChapter === active?.id) return;
      document.body.dataset.directionChapter = active?.id || 'direction';
      chapterLinks.forEach(link => {
        if (link.hash === `#${active?.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    let chapterUpdatePending = false;
    const scheduleChapterUpdate = () => {
      if (chapterUpdatePending) return;
      chapterUpdatePending = true;
      requestAnimationFrame(() => { updateChapter(); chapterUpdatePending = false; });
    };
    window.addEventListener('scroll', scheduleChapterUpdate, { passive: true });
    window.addEventListener('resize', scheduleChapterUpdate);
    updateChapter();
  </script>
</Layout>
